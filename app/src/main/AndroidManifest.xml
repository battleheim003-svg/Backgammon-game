<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The game also works with the on-screen button, so the accelerometer is optional. -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/royal_app_icon"
        android:roundIcon="@drawable/royal_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".Menus.SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:screenOrientation="landscape">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".Menus.MenuActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".GameControllers.GameActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".Menus.SettingsActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".Menus.ResultsActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".Menus.ScoresActivity"
            android:screenOrientation="landscape" />

    </application>

</manifest>
