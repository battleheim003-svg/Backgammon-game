<?xml version="1.0" encoding="utf-8"?>
<!-- An unlocked chapter: lapis panel, lit along the top, bounded by a gold hairline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient
        android:angle="270"
        android:startColor="@color/royal_panel_high"
        android:endColor="@color/royal_deep"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/gold_hairline" />
</shape>
