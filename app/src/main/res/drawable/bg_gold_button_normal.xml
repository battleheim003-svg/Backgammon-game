<?xml version="1.0" encoding="utf-8"?>
<!--
    Struck gold: a dark rim, a lit face inside it, and the tooth of the metal on
    top. The two shapes are what make the edge read as bevelled rather than as a
    border drawn around a flat colour.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/gold_bright"
                android:endColor="@color/gold_deep"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:top="1.5dp"
        android:bottom="2.5dp"
        android:start="1.5dp"
        android:end="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <gradient
                android:angle="270"
                android:startColor="#FBE0A6"
                android:centerColor="@color/gold"
                android:endColor="#B9822A"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:top="1.5dp"
        android:bottom="2.5dp"
        android:start="1.5dp"
        android:end="1.5dp">
        <bitmap
            android:src="@drawable/tex_foil_grain"
            android:tileMode="repeat" />
    </item>
</layer-list>
