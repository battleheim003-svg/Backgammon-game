<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed: the face sinks, so the lit edge moves to the bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:angle="90"
                android:startColor="@color/gold_bright"
                android:endColor="@color/gold_deep"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:top="2.5dp"
        android:bottom="1.5dp"
        android:start="1.5dp"
        android:end="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <gradient
                android:angle="270"
                android:startColor="#C08D31"
                android:endColor="#DFAE50"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
