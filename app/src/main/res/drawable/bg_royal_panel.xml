<?xml version="1.0" encoding="utf-8"?>
<!--
    The illuminated panel: a gold frame, a second hairline inside it, and the
    kashi field showing faintly through the lapis ground. The double rule is the
    manuscript convention — one heavy line, one light, with a margin between.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#4A2F1B"
                android:endColor="#1E120A"
                android:type="linear" />
            <stroke android:width="1.6dp" android:color="@color/gold" />
        </shape>
    </item>

    <item android:top="5dp" android:bottom="5dp" android:start="5dp" android:end="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="0.8dp" android:color="@color/gold_hairline" />
        </shape>
    </item>

    <item android:top="6dp" android:bottom="6dp" android:start="6dp" android:end="6dp">
        <bitmap
            android:src="@drawable/tex_kashi_panel"
            android:tileMode="repeat"
            android:tint="@color/gold" />
    </item>
</layer-list>
