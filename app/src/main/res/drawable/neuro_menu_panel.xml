<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="8dp" android:top="10dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#8A000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="7dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#33FFB057" />
