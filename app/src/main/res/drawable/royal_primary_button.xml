<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#C49B2D" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/royal_gold_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#B88924"
                android:startColor="@color/royal_gold_light" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FFF0A8" />
        </shape>
    </item>
</selector>
