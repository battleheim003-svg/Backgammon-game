<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#B88924"
                android:startColor="#E7C85C" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#FFF0A8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#F2D675"
                android:endColor="#A8741A"
                android:startColor="#FFF0A8" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#FFFFD1" />
        </shape>
    </item>
</selector>
