<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#E6147D70"
                android:startColor="#F01A0F0B" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/royal_gold_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#CC1A0F0B"
                android:startColor="#D83B2115" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#99D4AF37" />
        </shape>
    </item>
</selector>
