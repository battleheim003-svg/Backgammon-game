<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E6147D70" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/royal_gold_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E61A0F0B" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/royal_gold" />
        </shape>
    </item>
</selector>
