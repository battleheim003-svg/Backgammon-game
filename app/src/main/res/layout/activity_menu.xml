<?xml version="1.0" encoding="utf-8"?>
<!--
    Main menu.

    What changed and why: the six actions used to sit in a three-by-three grid
    where the last button spanned two columns, so nothing looked deliberate and
    "Play" carried no more weight than "Settings". Now one action is the hero and
    the other five are identical tiles in a single row — the shape of the screen
    states the hierarchy before a word is read.

    The badges that used to be emoji (🪙 🏅 🛍️) are vector icons: emoji render
    differently on every device and never matched the gold.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_royal_backdrop"
    android:layoutDirection="locale"
    tools:context=".Menus.MenuActivity">

    <!-- ── Top bar: wallet on the leading side, standing on the trailing side ── -->

    <LinearLayout
        android:id="@+id/menuTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:id="@+id/coinBalanceContainer"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_royal_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="13dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_royal_coin" />

            <TextView
                android:id="@+id/tvCoinBalance"
                style="@style/RoyalText.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@null"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="0" />
        </LinearLayout>

        <Button
            android:id="@+id/btnFreeCoins"
            style="@style/RoyalButton.Gold.Small"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:onClick="onFreeCoinsClicked"
            android:text="@string/free_coins" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/tvEloRatingContainer"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_royal_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:onClick="openPlayerStats"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="13dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_royal_medal" />

            <TextView
                android:id="@+id/tvEloRating"
                style="@style/RoyalText.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@null"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnShop"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_wood_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:onClick="openCoinShop"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="13dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_royal_shop" />

            <TextView
                style="@style/RoyalText.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@null"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/coin_shop" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── The crest, on the trailing side ─────────────────────────────────── -->

    <ImageView
        android:id="@+id/royalLogo"
        android:layout_width="184dp"
        android:layout_height="168dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="20dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:elevation="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/royal_backgammon_logo" />

    <!-- ── The illuminated panel ───────────────────────────────────────────── -->

    <LinearLayout
        android:id="@+id/menuPanel"
        android:layout_width="372dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_royal_panel"
        android:elevation="18dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_royal_crown" />

        <!-- The title is artwork: struck gold, lit by the same key light as the
             buttons. Rendered per language, so Persian and English each get
             letterforms cut for them rather than one bitmap stretched. -->
        <ImageView
            android:id="@+id/menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/title_app" />

        <TextView
            android:id="@+id/menuSubtitle"
            style="@style/RoyalText.Story"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/royal_subtitle" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/ic_arabesque_divider" />

        <TextView
            android:id="@+id/tvDailyChallenge"
            style="@style/RoyalText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/turquoise" />

        <!-- The one action the screen exists for -->
        <LinearLayout
            android:id="@+id/playGame"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_gold_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:onClick="openPlayOptions"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_royal_play" />

            <TextView
                style="@style/RoyalText.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="@string/play_game"
                android:textColor="@color/ink_on_gold"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Five equals. Same size, same structure, no column spans. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/passAndPlay"
                style="@style/RoyalMenuTile"
                android:onClick="openPassAndPlay">

                <ImageView
                    style="@style/RoyalMenuTile.Icon"
                    android:src="@drawable/ic_royal_duel" />

                <TextView
                    style="@style/RoyalMenuTile.Label"
                    android:text="@string/pass_and_play" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/journey"
                style="@style/RoyalMenuTile"
                android:layout_marginStart="7dp"
                android:onClick="openJourney">

                <ImageView
                    style="@style/RoyalMenuTile.Icon"
                    android:src="@drawable/ic_royal_road" />

                <TextView
                    style="@style/RoyalMenuTile.Label"
                    android:text="@string/journey_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tutorial"
                style="@style/RoyalMenuTile"
                android:layout_marginStart="7dp"
                android:onClick="startTutorial">

                <ImageView
                    style="@style/RoyalMenuTile.Icon"
                    android:src="@drawable/ic_royal_book" />

                <TextView
                    style="@style/RoyalMenuTile.Label"
                    android:text="@string/tutorial" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/scores"
                style="@style/RoyalMenuTile"
                android:layout_marginStart="7dp"
                android:onClick="scores">

                <ImageView
                    style="@style/RoyalMenuTile.Icon"
                    android:src="@drawable/ic_royal_trophy" />

                <TextView
                    style="@style/RoyalMenuTile.Label"
                    android:text="@string/scores" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings"
                style="@style/RoyalMenuTile"
                android:layout_marginStart="7dp"
                android:onClick="OpenSettings">

                <ImageView
                    style="@style/RoyalMenuTile.Icon"
                    android:src="@drawable/ic_royal_gear" />

                <TextView
                    style="@style/RoyalMenuTile.Label"
                    android:text="@string/settings" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/languageToggle"
        style="@style/RoyalButton.Wood"
        android:layout_width="118dp"
        android:layout_height="42dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="18dp"
        android:elevation="8dp"
        android:onClick="toggleLanguage"
        android:text="@string/language_toggle" />

</FrameLayout>
