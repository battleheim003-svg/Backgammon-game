<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/meny_background"
    android:layoutDirection="locale"
    tools:context=".Menus.MenuActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#78112532" />

    <LinearLayout
        android:id="@+id/menuTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Coin Balance -->
        <LinearLayout
            android:id="@+id/coinBalanceContainer"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pause_button"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCoinBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/accent_gold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="0" />
        </LinearLayout>

        <!-- Free Coins Button -->
        <Button
            android:id="@+id/btnFreeCoins"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/neuro_primary_button"
            android:elevation="4dp"
            android:fontFamily="sans-serif-medium"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:onClick="onFreeCoinsClicked"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/free_coins"
            android:textAllCaps="false"
            android:textColor="@color/surface_base"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- ELO rating badge -->
        <TextView
            android:id="@+id/tvEloRating"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pause_button"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="ELO 1200" />

        <!-- Shop Button -->
        <Button
            android:id="@+id/btnShop"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/neuro_secondary_button"
            android:elevation="4dp"
            android:fontFamily="sans-serif-medium"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:onClick="openCoinShop"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/coin_shop"
            android:textAllCaps="false"
            android:textColor="@color/accent_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ImageView
        android:id="@+id/royalLogo"
        android:layout_width="172dp"
        android:layout_height="156dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="44dp"
        android:layout_marginBottom="26dp"
        android:adjustViewBounds="true"
        android:elevation="6dp"
        android:contentDescription="@string/app_name"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/royal_backgammon_logo" />

    <View
        android:layout_width="360dp"
        android:layout_height="274dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:background="@drawable/royal_menu_panel_shadow" />

    <LinearLayout
        android:id="@+id/menuPanel"
        android:layout_width="352dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/neuro_menu_panel"
        android:elevation="18dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="@string/app_name"
            android:textColor="@color/accent_gold"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/royal_subtitle"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/royal_gold_divider" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2">

            <Button
                android:id="@+id/playGame"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="9dp"
                android:background="@drawable/neuro_primary_button"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:onClick="openPlayOptions"
                android:text="@string/play_game"
                android:textAllCaps="false"
                android:textColor="@color/surface_base"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/passAndPlay"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="9dp"
                android:background="@drawable/neuro_primary_button"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:onClick="openPassAndPlay"
                android:text="@string/pass_and_play"
                android:textAllCaps="false"
                android:textColor="@color/surface_base"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tutorial"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_columnWeight="1"
                android:layout_marginBottom="9dp"
                android:background="@drawable/neuro_secondary_button"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:onClick="startTutorial"
                android:text="@string/tutorial"
                android:textAllCaps="false"
                android:textColor="@color/accent_gold"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/scores"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/neuro_secondary_button"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:onClick="scores"
                android:text="@string/scores"
                android:textAllCaps="false"
                android:textColor="@color/accent_gold"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/settings"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_columnWeight="1"
                android:layout_columnSpan="2"
                android:background="@drawable/neuro_secondary_button"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:onClick="OpenSettings"
                android:text="@string/settings"
                android:textAllCaps="false"
                android:textColor="@color/accent_gold"
                android:textSize="16sp"
                android:textStyle="bold" />

        </GridLayout>

    </LinearLayout>

    <Button
        android:id="@+id/languageToggle"
        android:layout_width="116dp"
        android:layout_height="44dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="64dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/royal_language_button"
        android:elevation="8dp"
        android:fontFamily="sans-serif-medium"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:onClick="toggleLanguage"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/language_toggle"
        android:textAllCaps="false"
        android:textColor="@color/accent_gold"
        android:textSize="16sp"
        android:textStyle="bold" />

</FrameLayout>
