<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/meny_background"
    android:layoutDirection="locale"
    tools:context=".Menus.ResultsActivity">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_xl"
        android:background="@drawable/bg_royal_panel"
        android:elevation="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_l">

        <TextView
            android:id="@+id/mainResultsText"
            style="@style/RoyalText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/results_title"
            android:textColor="@color/accent_gold"
            android:textSize="@dimen/text_display" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginBottom="@dimen/space_s"
            android:background="@color/accent_gold" />

        <ListView
            android:id="@+id/resultList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@color/accent_gold"
            android:dividerHeight="1dp"
            android:listSelector="@android:color/transparent"
            android:overScrollMode="never" />

        <Button
            android:id="@+id/resultReset"
            style="@style/RoyalButton.Wood"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_md"
            android:layout_marginTop="@dimen/space_m"
            android:onClick="resetResults"
            android:text="@string/reset_results" />

    </LinearLayout>

</FrameLayout>
