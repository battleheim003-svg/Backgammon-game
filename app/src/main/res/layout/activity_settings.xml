<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/meny_background"
    android:layoutDirection="locale"
    tools:context=".Menus.SettingsActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_xl">

            <!-- ── Header Row ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_lg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_s">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnSettingsBack"
                    android:layout_width="@dimen/control_md"
                    android:layout_height="@dimen/control_md"
                    android:background="@drawable/bg_round_button_royal"
                    android:contentDescription="@string/review_back"
                    android:src="@drawable/gold_back" />

                <TextView
                    style="@style/RoyalText.Display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_title"
                    android:textColor="@color/accent_gold"
                    android:textSize="@dimen/text_display"
                    android:gravity="center" />

                <!-- Balance spacer matching back button -->
                <View
                    android:layout_width="@dimen/control_md"
                    android:layout_height="@dimen/control_md" />

            </LinearLayout>

            <!-- Gold divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/accent_gold"
                android:layout_marginBottom="@dimen/space_l" />


            <!-- ════════════════════════════════
                 SECTION 1 — SOUND
                 ════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_section_card"
                android:padding="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_m">

                <!-- Section header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_s">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔊"
                        android:textSize="@dimen/text_title"
                        android:layout_marginEnd="@dimen/space_s" />

                    <TextView
                        style="@style/RoyalText.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_audio"
                        android:textColor="@color/accent_gold"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#44F4B044"
                    android:layout_marginBottom="@dimen/space_m" />

                <!-- Sound toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_md"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_xs">

                    <TextView
                        style="@style/RoyalText.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sound_enabled"
                        android:textSize="@dimen/text_caption" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/accent_gold"
                        app:trackTint="@color/accent_gold_support" />
                </LinearLayout>

                <!-- Effects toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_md"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_m">

                    <TextView
                        style="@style/RoyalText.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/effects_enabled"
                        android:textSize="@dimen/text_caption" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEffects"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/accent_gold"
                        app:trackTint="@color/accent_gold_support" />
                </LinearLayout>

                <!-- SFX Volume -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_xs">

                    <TextView
                        style="@style/RoyalText.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sound"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/tvSfxVolumeValue"
                        style="@style/RoyalText.Chip"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/accent_gold"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderSfxVolume"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_sm"
                    android:max="100"
                    android:progress="80"
                    android:progressDrawable="@drawable/seekbar_pause_progress"
                    android:thumb="@drawable/seekbar_pause_thumb"
                    android:layout_marginBottom="@dimen/space_m" />

                <!-- Music Volume -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_xs">

                    <TextView
                        style="@style/RoyalText.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/music_volume"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/tvMusicVolumeValue"
                        style="@style/RoyalText.Chip"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/accent_gold"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderMusicVolume"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_sm"
                    android:max="100"
                    android:progress="55"
                    android:progressDrawable="@drawable/seekbar_pause_progress"
                    android:thumb="@drawable/seekbar_pause_thumb" />

            </LinearLayout>


            <!-- ════════════════════════════════
                 SECTION 2 — GAMEPLAY
                 ════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_section_card"
                android:padding="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_m">

                <!-- Section header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_s">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎮"
                        android:textSize="@dimen/text_title"
                        android:layout_marginEnd="@dimen/space_s" />

                    <TextView
                        style="@style/RoyalText.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_gameplay"
                        android:textColor="@color/accent_gold"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#44F4B044"
                    android:layout_marginBottom="@dimen/space_m" />

                <!-- Turn Speed -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_xs">

                    <TextView
                        style="@style/RoyalText.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/turn_delay"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/tvTurnSpeedValue"
                        style="@style/RoyalText.Chip"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/accent_gold"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderTurnSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_sm"
                    android:max="5"
                    android:progress="1"
                    android:progressDrawable="@drawable/seekbar_pause_progress"
                    android:thumb="@drawable/seekbar_pause_thumb" />

            </LinearLayout>


            <!-- ════════════════════════════════
                 SECTION 3 — SHAKE DICE
                 ════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_section_card"
                android:padding="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_xl">

                <!-- Section header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_s">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📳"
                        android:textSize="@dimen/text_title"
                        android:layout_marginEnd="@dimen/space_s" />

                    <TextView
                        style="@style/RoyalText.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_shake"
                        android:textColor="@color/accent_gold"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#44F4B044"
                    android:layout_marginBottom="@dimen/space_m" />

                <!-- Shake Sensitivity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_xs">

                    <TextView
                        style="@style/RoyalText.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/shake_sensitivity"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/tvShakeThresholdValue"
                        style="@style/RoyalText.Chip"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/accent_gold"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderShakeThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_sm"
                    android:max="1000"
                    android:progress="550"
                    android:progressDrawable="@drawable/seekbar_pause_progress"
                    android:thumb="@drawable/seekbar_pause_thumb"
                    android:layout_marginBottom="@dimen/space_m" />

                <!-- Shake Precision -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_xs">

                    <TextView
                        style="@style/RoyalText.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/shake_duration"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/tvShakePrecisionValue"
                        style="@style/RoyalText.Chip"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/accent_gold"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderShakePrecision"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_sm"
                    android:max="200"
                    android:progress="70"
                    android:progressDrawable="@drawable/seekbar_pause_progress"
                    android:thumb="@drawable/seekbar_pause_thumb"
                    android:layout_marginBottom="@dimen/space_m" />

                <!-- Shake Delay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_xs">

                    <TextView
                        style="@style/RoyalText.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_shake_delay"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/tvShakeDelayValue"
                        style="@style/RoyalText.Chip"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/accent_gold"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderShakeDelay"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_sm"
                    android:max="15"
                    android:progress="4"
                    android:progressDrawable="@drawable/seekbar_pause_progress"
                    android:thumb="@drawable/seekbar_pause_thumb" />

            </LinearLayout>


            <!-- Restore Defaults button -->
            <Button
                android:id="@+id/btnRestoreDefaults"
                style="@style/RoyalButton.Wood"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_md"
                android:text="@string/restore_defaults" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
