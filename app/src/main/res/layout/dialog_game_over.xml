<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pause_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="24dp"
    android:paddingEnd="28dp"
    android:paddingBottom="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/gameOverTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/game_over_title"
        android:textColor="@color/accent_gold"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Winner message -->
    <TextView
        android:id="@+id/gameOverWinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFFFFFF"
        android:textSize="19sp" />

    <!-- Game duration -->
    <TextView
        android:id="@+id/gameOverDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#99FFFFFF"
        android:textSize="14sp" />

    <!-- Win streak (only visible in vs_bot after a win) -->
    <TextView
        android:id="@+id/gameOverStreak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/accent_gold"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#33FFFFFF" />

    <!-- Rematch (primary action) -->
    <Button
        android:id="@+id/gameOverRematch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_roll_dice_amber"
        android:text="@string/rematch"
        android:textAllCaps="false"
        android:textColor="#FF1B1B2F"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Change Settings -->
    <Button
        android:id="@+id/gameOverChangeSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pause_button"
        android:text="@string/change_settings"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />

    <!-- Main Menu -->
    <Button
        android:id="@+id/gameOverMainMenu"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pause_button"
        android:text="@string/main_menu"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />

</LinearLayout>
