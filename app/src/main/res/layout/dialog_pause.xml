<?xml version="1.0" encoding="utf-8"?>
<!--
    Pause.

    What it was: a flat navy card with three coloured circles, typographic
    characters standing in for icons (⏸ ▶ ↺) and a stock seek bar. It belonged
    to a different app from the one around it.

    What it is now: the same walnut panel, the same struck plaques and the same
    gold icons as the menu — because a pause screen is the one surface a player
    sees mid-game, and it should not feel like leaving the game to use it.

    The three actions are ordered by how often they are wanted, with the safe one
    widest and first, and the one that ends the game last.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="372dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_royal_panel"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/gold_pause" />

    <TextView
        style="@style/RoyalText.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/pause_title"
        android:textSize="22sp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/ic_arabesque_divider" />

    <!-- Resume is the one the player almost always wants, so it is the hero -->
    <LinearLayout
        android:id="@+id/pauseResume"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_gold_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_royal_play" />

        <TextView
            style="@style/RoyalText.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="@string/pause_resume"
            android:textColor="@color/ink_on_gold"
            android:textSize="19sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/pauseRestart"
            style="@style/RoyalMenuTile"
            android:layout_height="66dp">

            <ImageView
                style="@style/RoyalMenuTile.Icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/gold_restart" />

            <TextView
                style="@style/RoyalMenuTile.Label"
                android:textSize="12sp"
                android:text="@string/pause_restart" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pauseQuit"
            style="@style/RoyalMenuTile"
            android:layout_height="66dp"
            android:layout_marginStart="10dp">

            <ImageView
                style="@style/RoyalMenuTile.Icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/gold_exit" />

            <TextView
                style="@style/RoyalMenuTile.Label"
                android:textSize="12sp"
                android:text="@string/pause_quit" />
        </LinearLayout>
    </LinearLayout>

    <!-- Volume, set into the panel rather than floating on it -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_royal_well"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/gold_sound" />

        <SeekBar
            android:id="@+id/pauseVolumeSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:max="100"
            android:progressDrawable="@drawable/bg_progress_track_royal"
            android:thumb="@drawable/thumb_royal" />
    </LinearLayout>
</LinearLayout>
