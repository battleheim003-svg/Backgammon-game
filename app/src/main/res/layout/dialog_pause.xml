<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pause_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="24dp"
    android:paddingEnd="32dp"
    android:paddingBottom="22dp">

    <!-- Header: PAUSE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/pause_title"
        android:textColor="#E6A100"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Button Row 1: Resume / Restart / Quit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/pauseResume"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pause_button"
            android:fontFamily="sans-serif-medium"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/pause_resume"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pauseRestart"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pause_button"
            android:fontFamily="sans-serif-medium"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/pause_restart"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pauseQuit"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pause_button"
            android:fontFamily="sans-serif-medium"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/pause_quit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Control Row 2: Volume -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_volume_track"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/pause_volume_desc"
            android:src="@drawable/ic_volume_up_gold" />

        <SeekBar
            android:id="@+id/pauseVolumeSeekBar"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="80"
            android:progressDrawable="@drawable/seekbar_pause_progress"
            android:thumb="@drawable/seekbar_pause_thumb" />

    </LinearLayout>

</LinearLayout>
