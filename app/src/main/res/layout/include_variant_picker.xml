<?xml version="1.0" encoding="utf-8"?>
<!-- Variant + match length picker, shared by the vs-bot and pass-and-play sheets -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/variantPicker"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/variantStandard"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_difficulty_normal"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/variant_standard"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="12sp" />

        <Button
            android:id="@+id/variantTavla"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_difficulty_normal"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/variant_tavla"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="12sp" />

        <Button
            android:id="@+id/variantPortes"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_difficulty_normal"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/variant_portes"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="12sp" />

        <Button
            android:id="@+id/matchLength"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_difficulty_normal"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/match_single"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/variantHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/color_difficulty_text_normal"
        android:textSize="11sp" />
</LinearLayout>
