<?xml version="1.0" encoding="utf-8"?>
<!--
    One chapter on the road. Everything the player needs to decide whether to tap
    it is on the face of the card: which number, who they face, which variant, how
    long the match is, what it pays, and one line of story.

    The card's background, the seal and the badge are swapped in code for the three
    states (locked / current / completed) rather than being three separate layouts.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stageCard"
    android:layout_width="156dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_stage"
    android:orientation="vertical"
    android:paddingStart="11dp"
    android:paddingTop="12dp"
    android:paddingEnd="11dp"
    android:paddingBottom="12dp">

    <!-- Seal + state badge -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/stageSeal"
            android:layout_width="42dp"
            android:layout_height="42dp">

            <!-- Each chapter has its own struck seal: a different fold count and
                 a different enamel, so nine chapters are nine marks. -->
            <ImageView
                android:id="@+id/stageEmblem"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/stageNumber"
                style="@style/RoyalText.Seal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="@color/ink_parchment"
                android:textSize="15sp" />
        </FrameLayout>

        <ImageView
            android:id="@+id/stageBadge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@null"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/stageTitle"
        style="@style/RoyalText.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/stageOpponent"
        style="@style/RoyalText.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Fact chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/stageVariantChip"
            style="@style/RoyalText.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/stageMatchChip"
            style="@style/RoyalText.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/stageFlavor"
        style="@style/RoyalText.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:minLines="3" />

    <!-- Reward and the call to action share the footer line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/stageCoinIcon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_royal_coin" />

        <TextView
            android:id="@+id/stageReward"
            style="@style/RoyalText.Chip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="start|center_vertical"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <ImageView
            android:id="@+id/stageGo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_royal_chevron" />
    </LinearLayout>
</LinearLayout>
