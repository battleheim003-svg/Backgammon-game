<?xml version="1.0" encoding="utf-8"?>
<!--
    One shop product.

    The card itself is the rarity: bronze, silver, turquoise glaze or gold, cast
    as a metal frame around a quiet wood field, and the medallion mounted on it
    is struck in that same metal. A legendary item is gold all the way through
    rather than labelled legendary, which is what makes the shelf readable at a
    glance — and readable in this game's terms rather than a stock palette's.

    The background is set in code (ShopArt.card) because rarity is data.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="5dp">

    <LinearLayout
        android:id="@+id/shopCardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_common"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- Kept for older layouts that still bind it; hidden by the adapter. -->
        <View
            android:id="@+id/viewRarityBar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="62dp"
            android:layout_height="62dp">

            <TextView
                android:id="@+id/tvShopItemIcon"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/medal_shop_common"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvShopItemQuantityBadge"
                style="@style/RoyalText.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textSize="9.5sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvShopItemRarity"
            style="@style/RoyalText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.06"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/tvShopItemTitle"
            style="@style/RoyalText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvShopItemDesc"
            style="@style/RoyalText.Story"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:textSize="11.5sp" />

        <LinearLayout
            android:id="@+id/layoutShopItemUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivShopItemLock"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/gold_lock" />

            <TextView
                android:id="@+id/tvShopItemUnlock"
                style="@style/RoyalText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:textColor="@color/terracotta"
                android:textSize="10sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/shopItemUnlockProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progressDrawable="@drawable/bg_progress_track_royal"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnShopItemAction"
            style="@style/RoyalButton.Gold"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvShopItemBadge"
        style="@style/RoyalText.Chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/bg_chip_turquoise"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="@color/turquoise"
        android:textSize="9sp"
        android:visibility="gone" />
</FrameLayout>
