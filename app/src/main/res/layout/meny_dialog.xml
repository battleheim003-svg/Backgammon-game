<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@drawable/royal_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/editText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/player_one"
                android:textColor="@color/royal_gold_light"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/dialogPName1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/player_name"
                android:inputType="textPersonName"
                android:text="@string/player_one"
                android:textColor="@color/royal_ivory"
                android:textColorHint="@color/royal_muted"
                android:textDirection="rtl" />

            <RadioGroup
                android:id="@+id/dialogRadioGP1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@id/radioButton"
                android:gravity="center"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:buttonTint="@color/royal_gold"
                    android:text="@string/human_player"
                    android:textColor="@color/royal_ivory" />

                <RadioButton
                    android:id="@+id/radioButton2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:buttonTint="@color/royal_gold"
                    android:text="@string/bot_player"
                    android:textColor="@color/royal_ivory" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/editText2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/player_two"
                android:textColor="@color/royal_gold_light"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/dialogPName2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/player_name"
                android:inputType="textPersonName"
                android:text="@string/bot_player"
                android:textColor="@color/royal_ivory"
                android:textColorHint="@color/royal_muted"
                android:textDirection="rtl" />

            <RadioGroup
                android:id="@+id/dialogRadioGP2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@id/radioButton4"
                android:gravity="center"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioButton3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:buttonTint="@color/royal_gold"
                    android:text="@string/human_player"
                    android:textColor="@color/royal_ivory" />

                <RadioButton
                    android:id="@+id/radioButton4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:buttonTint="@color/royal_gold"
                    android:text="@string/bot_player"
                    android:textColor="@color/royal_ivory" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/bot_difficulty"
                android:textColor="@color/royal_gold_light"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/dialogBotDifficulty"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:entries="@array/bot_difficulty_entries"
                android:gravity="center"
                android:popupBackground="@color/royal_walnut_dark" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/board_theme"
                android:textColor="@color/royal_gold_light"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/dialogBoardTheme"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:entries="@array/board_theme_entries"
                android:gravity="center"
                android:popupBackground="@color/royal_walnut_dark" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialogCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/royal_secondary_button"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/royal_ivory"
            android:textSize="18sp" />

        <Button
            android:id="@+id/dialogPlay"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/royal_primary_button"
            android:text="@string/play"
            android:textAllCaps="false"
            android:textColor="@color/royal_walnut_dark"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
