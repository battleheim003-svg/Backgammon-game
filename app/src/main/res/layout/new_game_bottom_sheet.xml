<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/newGameSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <!-- Drag Handle -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Title & Player Name Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="بازی جدید"
            android:textColor="@color/accent_gold"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <EditText
            android:id="@+id/singlePlayerName"
            android:layout_width="160dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_name_field_normal"
            android:cursorVisible="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:hint="@string/player_name"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:text="@string/player_one"
            android:textColor="@color/color_player_name_text"
            android:textColorHint="@color/color_player_name_hint"
            android:textDirection="rtl"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Theme Grid: 2 rows × 4 columns of 80dp × 80dp thumbnails with labels below -->
    <LinearLayout
        android:id="@+id/themeGridContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Row 1: Themes 0-3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Theme 0: Royal -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/themeThumb0"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_theme_thumb_selected"
                    android:padding="3dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/preview_theme_royal" />
                </FrameLayout>

                <TextView
                    android:id="@+id/themeLabel0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/theme_royal"
                    android:textColor="@color/color_player_name_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Theme 1: Pop Art -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/themeThumb1"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_theme_thumb_normal"
                    android:padding="3dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/preview_theme_pop_art" />
                    <LinearLayout
                        android:id="@+id/lockOverlay1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/color_lock_overlay"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_lock_theme" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/watch_ad_unlock"
                            android:textColor="@color/color_gold_primary"
                            android:textSize="7sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/themeLabel1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/theme_pop_art"
                    android:textColor="@color/color_player_name_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Theme 2: Cyberpunk -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/themeThumb2"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_theme_thumb_normal"
                    android:padding="3dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/preview_theme_cyberpunk" />
                    <LinearLayout
                        android:id="@+id/lockOverlay2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/color_lock_overlay"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_lock_theme" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/watch_ad_unlock"
                            android:textColor="@color/color_gold_primary"
                            android:textSize="7sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/themeLabel2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/theme_cyberpunk"
                    android:textColor="@color/color_player_name_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Theme 3: Luxury -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/themeThumb3"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_theme_thumb_normal"
                    android:padding="3dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/preview_theme_luxury" />
                    <LinearLayout
                        android:id="@+id/lockOverlay3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/color_lock_overlay"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_lock_theme" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/watch_ad_unlock"
                            android:textColor="@color/color_gold_primary"
                            android:textSize="7sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/themeLabel3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/theme_luxury"
                    android:textColor="@color/color_player_name_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Themes 4-7 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Theme 4: Woodland -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/themeThumb4"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_theme_thumb_normal"
                    android:padding="3dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/preview_theme_woodland" />
                    <LinearLayout
                        android:id="@+id/lockOverlay4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/color_lock_overlay"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_lock_theme" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/watch_ad_unlock"
                            android:textColor="@color/color_gold_primary"
                            android:textSize="7sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/themeLabel4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/theme_woodland_name"
                    android:textColor="@color/color_player_name_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Theme 5: Galaxy -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/themeThumb5"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_theme_thumb_normal"
                    android:padding="3dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/preview_theme_galaxy" />
                    <LinearLayout
                        android:id="@+id/lockOverlay5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/color_lock_overlay"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_lock_theme" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/watch_ad_unlock"
                            android:textColor="@color/color_gold_primary"
                            android:textSize="7sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/themeLabel5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/theme_galaxy"
                    android:textColor="@color/color_player_name_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Theme 6: Ancient Egypt -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/themeThumb6"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_theme_thumb_normal"
                    android:padding="3dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/preview_theme_egypt" />
                    <LinearLayout
                        android:id="@+id/lockOverlay6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/color_lock_overlay"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_lock_theme" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/watch_ad_unlock"
                            android:textColor="@color/color_gold_primary"
                            android:textSize="7sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/themeLabel6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/theme_ancient_egypt"
                    android:textColor="@color/color_player_name_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Theme 7: Neon Retro -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/themeThumb7"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_theme_thumb_normal"
                    android:padding="3dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/preview_theme_neon" />
                    <LinearLayout
                        android:id="@+id/lockOverlay7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/color_lock_overlay"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_lock_theme" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/watch_ad_unlock"
                            android:textColor="@color/color_gold_primary"
                            android:textSize="7sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/themeLabel7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/theme_neon_retro"
                    android:textColor="@color/color_player_name_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Difficulty selector row below the grid -->
    <LinearLayout
        android:id="@+id/difficultyRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/diffEasy"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_difficulty_normal"
            android:fontFamily="sans-serif-medium"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/difficulty_easy"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13sp" />

        <Button
            android:id="@+id/diffMedium"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_difficulty_selected"
            android:fontFamily="sans-serif-medium"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/difficulty_medium"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_selected"
            android:textSize="13sp" />

        <Button
            android:id="@+id/diffHard"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_difficulty_normal"
            android:fontFamily="sans-serif-medium"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/difficulty_hard"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13sp" />

        <Button
            android:id="@+id/diffRoyal"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_difficulty_normal"
            android:fontFamily="sans-serif-medium"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/difficulty_royal"
            android:textAllCaps="false"
            android:textColor="@color/color_difficulty_text_normal"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action Buttons Row: Cancel (outlined) and Play (filled gold gradient) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/singleCancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:fontFamily="sans-serif-medium"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/color_cancel_button_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="@color/color_cancel_button_text"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/singlePlay"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1.4"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button_play"
            app:backgroundTint="@null"
            android:fontFamily="sans-serif-medium"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/play"
            android:textAllCaps="false"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:elevation="6dp" />
    </LinearLayout>
</LinearLayout>
