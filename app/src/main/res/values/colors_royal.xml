<?xml version="1.0" encoding="utf-8"?>
<!--
    Royal palette — one visual language for the whole app.

    The reference is a Persian illuminated manuscript: a lapis-blue night ground,
    gold leaf for everything that matters, turquoise for the living accents and a
    parchment cream for text. Nothing here is a flat UI grey.

    Use the semantic names (royal_*, gold_*, ink_*) in layouts; the raw hues stay
    private to this file so the whole app can be re-tinted from one place.
-->
<resources>

    <!-- Grounds: from the darkest night to the panel that sits on top of it -->
    <color name="royal_night">#080C22</color>
    <color name="royal_deep">#101638</color>
    <color name="royal_panel">#1A2352</color>
    <color name="royal_panel_high">#26316B</color>
    <color name="royal_lapis">#2E3E8F</color>

    <!-- Gold leaf: the illumination. bright = lit edge, deep = shadowed edge -->
    <color name="gold_bright">#F7D488</color>
    <color name="gold">#E0AE4C</color>
    <color name="gold_deep">#9C6B1E</color>
    <color name="gold_ghost">#33E0AE4C</color>
    <color name="gold_hairline">#55E0AE4C</color>

    <!-- Turquoise (فیروزه): the second voice — progress, success, the living state -->
    <color name="turquoise">#34C5AC</color>
    <color name="turquoise_deep">#17705F</color>
    <color name="turquoise_ghost">#2634C5AC</color>

    <!-- Terracotta: warnings, locked seals, the clay of the tilework -->
    <color name="terracotta">#C4552F</color>

    <!-- Ink: text on the dark ground -->
    <color name="ink_parchment">#F4E9D0</color>
    <color name="ink_soft">#C3C9E4</color>
    <color name="ink_muted">#8189B0</color>
    <color name="ink_on_gold">#231504</color>

    <!-- Scrims and shadows -->
    <color name="royal_scrim">#B3080C22</color>
    <color name="royal_shadow">#66000000</color>
</resources>
